# Prototype defaults. The app runs with mock tweets without these.
NEXT_PUBLIC_APP_NAME=tweet-hunt

# Add real OAuth values only when wiring live X/Twitter integration.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/api/oauth/callback
TOKEN_ENCRYPTION_KEY=

# Keep destructive API calls disabled until the safety model is complete.
ENABLE_LIVE_DELETE=false
