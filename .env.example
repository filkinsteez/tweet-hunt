# Prototype defaults. The app runs with mock tweets without these.
NEXT_PUBLIC_APP_NAME=tweet-hunt

# X OAuth 2.0 authorization code flow with PKCE.
# Create/configure a Developer App at https://developer.x.com with:
#   Type of App: Web App, Automated App or Bot (confidential client)
#   OAuth 2.0: enabled
#   App permissions: Read minimum
#
# The credentials and callback must come from the same X Developer Portal
# environment you are testing. If your app is under "Development", use that
# app's keys for local development. For production, use the production app/env
# keys in Vercel.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Local development callback:
X_REDIRECT_URI=http://localhost:3000/api/oauth/callback
#
# Production callback:
# X_REDIRECT_URI=https://tweet-hunt.com/api/oauth/callback
#
# Add both callback URIs in the X app's User authentication settings when that
# app/environment is used for both local and production testing.

# Required scopes:
#   users.read tweet.read tweet.write
# offline.access is intentionally not requested yet.

# Optional: future use for encrypting tokens at rest if you move them to a DB.
TOKEN_ENCRYPTION_KEY=

# Keep disabled for local/mock development. Set true only in environments where
# shooting tweet birds should delete live X tweets.
ENABLE_LIVE_DELETE=false
